# Copie para .env (na raiz do projeto) e preencha. O .env nunca vai para o Git.
# No Railway estas variáveis ficam na aba Variables do serviço (veja GUIA-RAILWAY.md).

# ----- Banco -----
DB_URL=jdbc:postgresql://localhost:5432/searchoteca
DB_USER=searchoteca
DB_PASSWORD=

# ----- Segurança -----
# no mínimo 32 caracteres; gere com: openssl rand -base64 48
JWT_SECRET=

# ----- E-mail (Resend) -----
RESEND_API_KEY=
MAIL_FROM=Searchoteca <no-reply@seu-dominio.com.br>

# ----- MFA -----
MFA_ENABLED=true
# só para desenvolvimento: aceita este código sem mandar e-mail. NUNCA preencher em produção.
MFA_MOCK_CODE=

# ----- Vendas (valor inicial; depois o root muda em Configurações) -----
SALES_ENABLED=false

# ----- Logs -----
# na sua máquina grava em arquivo; no Railway deixe sem definir (só console)
LOG_FILE=logs/searchoteca.log
LOG_LEVEL_APP=DEBUG
